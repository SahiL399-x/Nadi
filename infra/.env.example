# Copy to infra/.env and adjust for your network. docker compose reads it automatically.
# Everything has a working default — you only need this file for the 3-phone LAN demo.

# MinIO endpoint that presigned report-upload URLs are signed against.
# Default (http://minio:9000) works for container-to-container only. For the phones
# to upload over the LAN, set this to the laptop's LAN IP (same one the app's
# EXPO_PUBLIC_API_URL points at). Find it with `ipconfig` (Windows) / `ifconfig`.
#S3_ENDPOINT=http://192.168.1.50:9000
